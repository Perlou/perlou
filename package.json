{
    "name": "perlou",
    "version": "1.0.0",
    "main": "scripts/index.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/Perlou/perlou"
    },
    "author": "perlou",
    "license": "UNLICENSED",
    "type": "module",
    "config": {
        "GITHUB_UID": "perlou",
        "NPM_UID": "perlou"
    },
    "nodemonConfig": {
        "ignore": [
            "output/*",
            "widgets/*",
            "icons/*"
        ]
    },
    "scripts": {
        "dev": "nodemon --exec tsx ./scripts/index.ts",
        "generate": "tsx ./scripts/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test scripts/*.test.ts",
        "check": "npm run typecheck && npm test",
        "format": "prettier ./scripts --write"
    },
    "dependencies": {
        "axios": "^1.7.x",
        "devicon": "^2.x",
        "fs-extra": "^11.x",
        "prettier": "^3.x",
        "simple-icons": "^13.x"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^25.9.1",
        "nodemon": "^3.x",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3"
    }
}
